# --- Database ---
DATABASE_URL="postgresql://scs:scs@localhost:5432/shekse_code_sync?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001
# Base URL the extension and web app use to reach the API
API_BASE_URL="http://localhost:3001"

# --- Web / Auth.js ---
WEB_PORT=3000
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Shared secret signing the ShekseCodeSync token (web mints, api verifies).
# Must be identical for @scs/web and @scs/api. Generate: openssl rand -base64 32
SCS_TOKEN_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Shared secret guarding api's /internal/users/* routes - web's only path to
# read/write user rows (it never talks to Postgres directly). Must be
# identical for @scs/web and @scs/api; never given to the extension/browser.
# Generate: openssl rand -base64 32
INTERNAL_API_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- AI provider (vendor-neutral) ---
# provider: anthropic | openai | ollama
AI_PROVIDER="anthropic"
AI_MODEL="claude-opus-4-8"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional: point the openai provider at any OpenAI-compatible endpoint
# (Azure, Bedrock-style gateways, self-hosted). Unset -> the SDK default.
OPENAI_BASE_URL=""
OLLAMA_BASE_URL="http://localhost:11434/v1"

# --- GitHub App (repo writes) ---
# Register at https://github.com/settings/apps/new with Contents: Read & write,
# Setup URL http://localhost:3000/github/installed, webhook off.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# The App's URL slug, used for the one-click "Connect GitHub repo" install link
# (https://github.com/apps/<slug>/installations/new). Public - safe in the client.
NEXT_PUBLIC_GITHUB_APP_SLUG=""
