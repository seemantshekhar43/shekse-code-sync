# --- Database ---
DATABASE_URL="postgresql://scs:scs@localhost:5432/shekse_code_sync?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001
# Base URL the extension and web app use to reach the API
API_BASE_URL="http://localhost:3001"

# --- Web / Auth.js ---
WEB_PORT=3000
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- AI provider (vendor-neutral) ---
# provider: anthropic | openai | ollama
AI_PROVIDER="anthropic"
AI_MODEL="claude-opus-4-8"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434/v1"

# --- GitHub App (repo writes) ---
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
